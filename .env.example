# Copy to .env on the server (never commit .env). Read by `npm start`.

# Node server
PORT=3000
ORIGIN=https://themostimportant.page

# Behind nginx: take the client IP from X-Forwarded-For (used by the rate limit).
# Without these, every visitor shares 127.0.0.1 and one hourly quota.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# AI (theme → vocabulary). Without a key, the SUMMON box answers "AI is not configured".
ANTHROPIC_API_KEY=
# Theme generations allowed per client IP per hour
RATE_LIMIT_PER_HOUR=20
