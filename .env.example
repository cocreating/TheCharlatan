# Copy to .env on the server (never commit .env). Read by `npm start`.

# Node server
PORT=3000
ORIGIN=https://themostimportant.page

# Behind nginx: take the client IP from X-Forwarded-For (used by the rate limit).
# Without these, every visitor shares 127.0.0.1 and one hourly quota.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# --- AI (theme → vocabulary) -------------------------------------------------
# Configure ONE provider. Without any, the SUMMON box answers "AI is not configured".
# If several are set, the first one wins (gemini, openai, anthropic) unless
# AI_PROVIDER forces one.
# AI_PROVIDER=gemini

# Google Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model (default: gemini-flash-latest, the current Flash model)
# GEMINI_MODEL=gemini-flash-latest
# If Flash is overloaded (503 "high demand"), try: gemini-flash-lite-latest

# Any OpenAI-compatible API (Groq, OpenRouter, Mistral, local Ollama...)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (paid)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Theme generations allowed per client IP per hour
RATE_LIMIT_PER_HOUR=20
